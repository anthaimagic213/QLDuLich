# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env.

# --- App ---
APP_NAME=TeamBuilding Portal
APP_ENV=development
API_PREFIX=/api/v1
TZ=Asia/Ho_Chi_Minh
DEBUG=true
SQL_ECHO=false

# --- Database ---
DATABASE_URL=sqlite:///./data/sqlite/teambuilding.db

# --- Auth ---
# BẮT BUỘC — docker compose không chạy nếu để trống (không còn khoá mặc định).
# Sinh khoá: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (chỉ cần khi chạy FE ở cổng riêng lúc dev) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=BTC Team Building
SMTP_FROM_EMAIL=noreply@company.vn
# Tắt khi dùng SMTP local để thử (Mailpit/MailHog) hoặc relay nội bộ cổng 25.
SMTP_STARTTLS=true
APP_PUBLIC_URL=http://localhost:3000

# --- RAG / LLM ---
# Provider: "gemini" hoặc "openai" (cho TrollLLM, OpenAI, v.v.)
LLM_PROVIDER=openai
# API key cho LLM (Gemini API key hoặc OpenAI-compatible API key)
LLM_API_KEY=
# Base URL cho OpenAI-compatible API (ví dụ: https://chat.trollllm.xyz/v1)
# Để trống nếu dùng OpenAI chính thức
LLM_BASE_URL=https://chat.trollllm.xyz/v1
# Tên model (ví dụ: gpt-6.1-sol cho TrollLLM, gemini-3.6-flash cho Gemini)
LLM_MODEL=gpt-6.1-sol
# Chỉ dùng khi LLM_PROVIDER=gemini và LLM_API_KEY trống
GEMINI_API_KEY=
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.2
CHAT_RATE_LIMIT_PER_10MIN=20


# --- Upload ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=2

# --- Frontend (dùng lúc build) ---
VITE_API_BASE_URL=/api/v1
